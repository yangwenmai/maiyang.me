{{- $pages := where .Site.RegularPages "Section" "post" }}
{{- if not .IsHome }}{{ $pages = .Pages }}{{ end }}
{{- $limit := .Site.Config.Services.RSS.Limit | default 20 }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ .Site.Params.logoTitle }}{{ else }}{{ .Title }} · {{ .Site.Params.logoTitle }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <language>zh-CN</language>
    {{- with $pages }}<lastBuildDate>{{ (index .ByDate.Reverse 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range first $limit $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ if .Site.Params.rssFullContent }}{{ .Content | html }}{{ else }}{{ .Summary | html }}{{ end }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
